{
  "name": "microproduct-template",
  "version": "3.0.3",
  "description": "A template for creating new micro product repositories",
  "repository": "https://github.com/optum-rx-innovation/micro-product-template",
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "packages/**/*",
    "surfaces/**/*"
  ],
  "scripts": {
    "generate": "npx @optum-rx-platform/cli@latest generate",
    "migrate": "npx @optum-rx-platform/cli@latest migrate",
    "release": "npx @optum-rx-platform/cli@latest run-script generate-mixed-release-json",
    "test": "jest --coverage --passWithNoTests --runInBand",
    "cy": "cypress open --component --browser electron",
    "cy:run": "cypress run --component --browser electron",
    "cy:run:ci": "NO_COLOR=1 yarn cy:run",
    "build:all": "lerna run build",
    "build:all:ci": "lerna run build",
    "lerna": "lerna",
    "prepare": "husky install",
    "postinstall": "yarn prepare",
    "lint": "eslint --config .eslintrc.js --ignore-path .eslintignore \"**/*.+(js|jsx|ts|tsx)\"",
    "lint:fix": "eslint --fix --config .eslintrc.js --ignore-path .eslintignore \"**/*.+(js|jsx|ts|tsx)\"",
    "format": "yarn format:nowrite --write",
    "format:nowrite": "prettier --ignore-path .eslintignore \"**/*.+(js|ts|tsx|html|css|scss|json)\"",
    "format:check": "yarn format:nowrite --list-different --list-different",
    "build-storybook": "storybook build -o storybook-build",
    "storybook": "storybook dev -p 6006 -h localhost",
    "orx-core-client-management": "yarn workspace @optum-rx-core/orx-core-client-management-webcomponent dev",
    "cm:dev": "yarn orx-core-client-management",
    "orx-core-file-center": "yarn workspace @optum-rx-core/orx-core-file-center-webcomponent dev",
    "fc:dev": "yarn orx-core-file-center",
    "orx-core-admin-settings": "yarn workspace @optum-rx-core/orx-core-admin-settings-webcomponent dev",
    "as:dev": "yarn orx-core-admin-settings",
    "orx-core-products": "yarn workspace @optum-rx-core/orx-core-products-webcomponent dev",
    "pr:dev": "yarn orx-core-products",
    "orx-core-pricing-webcomponent": "yarn workspace @optum-rx-core/orx-core-pricing-webcomponent dev"
  },
  "engines": {
    "node": ">=18.*.*"
  },
  "browserslist": [
    "Chrome >= 79",
    "Safari >= 12",
    "Edge >= 17",
    "ie 11",
    "Firefox >= 69",
    "iOS >= 13"
  ],
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/plugin-transform-class-properties": "^7.25.4",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.24.7",
    "@babel/plugin-transform-optional-chaining": "^7.24.8",
    "@babel/plugin-transform-typescript": "^7.23.6",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.12.10",
    "@babel/preset-typescript": "^7.12.7",
    "@jest/globals": "^29.7.0",
    "@storybook/addon-a11y": "^8.3.0",
    "@storybook/addon-actions": "^8.3.0",
    "@storybook/addon-essentials": "^8.3.0",
    "@storybook/addon-links": "^8.3.0",
    "@storybook/addon-storysource": "^8.3.0",
    "@storybook/addon-themes": "^8.3.0",
    "@storybook/addon-viewport": "^8.3.0",
    "@storybook/blocks": "^8.3.0",
    "@storybook/react": "^8.3.0",
    "@storybook/react-vite": "^8.6.12",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^16.0.0",
    "@types/dagre": "^0.7.48",
    "@types/express": "^4.17.17",
    "@types/jsonpath": "^0.2.0",
    "@types/node": "^18.0.0",
    "@types/react": "^18.0.25",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@uhg-optum-rx-platform/cli": "latest",
    "@uhg-skyline/eslint-plugin-optum": "^1.9.3",
    "@uhg-skyline/prettier": "^0.6.2",
    "@uhg-skyline/typescript": "0.7.2",
    "@uhg-skyline/yarn-plugin-skyline": "^0.11.2",
    "babel-jest": "^29.0.0",
    "babel-plugin-istanbul": "^6.1.1",
    "core-js": "^3.18.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^3.5.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^28.8.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-sonarjs": "^0.25.1",
    "eslint-plugin-storybook": "^0.6.12",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lerna": "^8.2.1",
    "msw": "^2.8.2",
    "msw-storybook-addon": "^2.0.4",
    "prettier": "^3.3.3",
    "regenerator-runtime": "^0.13.9",
    "remark-gfm": "^3.0.1",
    "require-from-string": "^2.0.2",
    "sonarqube-scanner": "^2.8.0",
    "storybook": "^8.3.0",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "tss-react": "^4.5.2",
    "typescript": "^5.5.4",
    "vite": "^6.3.2",
    "yargs": "^17.7.2",
    "yup": "0.32.11"
  },
  "dependencies": {
    "@emotion/react": "11.10.6",
    "@emotion/styled": "11.10.0",
    "@mui/icons-material": "^5.10.16",
    "@mui/material": "^5.10.0",
    "@mui/system": "^5.10.0",
    "@mui/utils": "^5.9.3",
    "@optum-rx-skyline/components": "^0.5.1",
    "@optum-rx-skyline/runtime-themes": "^0.1.1",
    "@optum-rx-skyline/themes": "^0.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tslib": "^2.3.1"
  },
  "resolutions": {
    "@adobe/css-tools": "^4.3.2",
    "@babel/traverse": "^7.23.9",
    "@types/react": "18.2.21",
    "@types/react-dom": "18.2.7",
    "body-parser": "^1.20.3",
    "braces": "^3.0.3",
    "browserify-sign": "^4.2.2",
    "cross-spawn": "^7.0.5",
    "elliptic": "^6.6.1",
    "ejs": "^3.1.10",
    "esbuild": "^0.25.0",
    "express": "^4.20.0",
    "follow-redirects": "^1.15.6",
    "form-data": "^4.0.4",
    "ip": "^2.0.1",
    "linkifyjs": "^4.3.2",
    "micromatch": "^4.0.8",
    "nanoid": "^3.3.8",
    "nise": "^5.1.6",
    "path-to-regexp": "^0.1.12",
    "send": "^0.19.0",
    "socks": "^2.8.3",
    "ws": "^8.17.1",
    "zod": "^3.24.1",
    "@hookform/resolvers": "3.3.0",
    "tar": "^7.5.8",
    "axios": "^1.13.5",
    "lerna": "^8.2.4",
    "js-yaml": "4.1.1"
  }
}
